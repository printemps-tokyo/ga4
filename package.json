{
  "name": "@printemps-tokyo/ga4",
  "version": "0.1.1",
  "description": "Check a GA4 property's recent traffic (users, sessions, pageviews) from the terminal. Zero-dependency CLI.",
  "type": "module",
  "license": "MIT",
  "author": "printemps.tokyo <develop@printemps.tokyo>",
  "homepage": "https://github.com/printemps-tokyo/ga4#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/printemps-tokyo/ga4.git"
  },
  "bugs": {
    "url": "https://github.com/printemps-tokyo/ga4/issues"
  },
  "keywords": [
    "ga4",
    "google-analytics",
    "analytics",
    "stats",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ga4": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check-shared": "node scripts/check-shared.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
